use io

# basic try/catch
try
    panic("oops")
catch e
    io.write(`caught: {e}`)

# try/catch with finally
try
    io.write("try")
catch
    io.write("catch")
finally
    io.write("finally")

# try without error, finally should still run
try
    io.write("try ok")
catch e
    io.write(`catch {e}`)
finally
    io.write("finally ok")

# defer
fn test_defer()
    defer io.write("defer1")
    defer io.write("defer2")
    io.write("body")

test_defer()

# nested
try
    try
        panic("inner")
    catch e
        io.write(`inner caught {e}`)
        panic("outer")
catch e
    io.write(`outer caught {e}`)

io.write("done")
