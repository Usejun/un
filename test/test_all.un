use io

io.write("=== literals ===")

i = 123
f = 3.14
b = true
s = "hello"

io.write(i)
io.write(f)
io.write(b)
io.write(s)

io.write()
io.write("=== grouping ===")

x = (1)
y = (1 + 2) * 3

io.write(x)
io.write(y)

io.write()
io.write("=== tuple ===")

t = (1, 2)
io.write(t)

a, b = t

io.write(a)
io.write(b)

io.write()
io.write("=== list ===")

list = [
    1,
    2,
    3,
    4
]

io.write(list)
io.write(list[0])
io.write(list[3])

list[1] = 99

io.write(list)

io.write()
io.write("=== nested list ===")

graph = [
    [0, 5, 10],
    [1, 2, 3],
    [7, 8, 9]
]

io.write(graph[0][1])
io.write(graph[2][2])

graph[0][1] = 123

io.write(graph[0][1])

io.write()
io.write("=== dict ===")

d = {
    "name": "un",
    "age": 20
}

io.write(d)

io.write()
io.write("=== function ===")

fn add(a, b)
    -> a + b

io.write(add(3, 4))

io.write()
io.write("=== default arg ===")

fn greet(name = "world")
    -> `hello {name}`

io.write(greet())
io.write(greet("un"))

io.write()
io.write("=== lambda ===")

mul = fn(a, b) -> a * b

io.write(mul(6, 7))

io.write()
io.write("=== fstring ===")

name = "Un"
version = 1

io.write(`language: {name} v{version}`)

io.write()
io.write("=== if ===")

if 10 > 5
    io.write("ok")
else
    io.write("fail")

io.write()
io.write("=== while ===")

n = 0

while n < 5
    io.write(n)
    n += 1

io.write()
io.write("=== for ===")

sum = 0

for x in [1, 2, 3, 4, 5]
    sum += x

io.write(sum)

io.write()
io.write("=== break ===")

n = 0

while true
    if n == 3
        break

    io.write(n)
    n += 1

io.write()
io.write("=== continue ===")

for x in [0, 1, 2, 3, 4]
    if x == 2
        skip

    io.write(x)

io.write()
io.write("=== class ===")

class Point(x, y)

    fn len()
        -> self.x + self.y

p = Point(10, 20)

io.write(p.x)
io.write(p.y)
io.write(p.len())

io.write()
io.write("=== destructuring ===")

x, y = (100, 200)

io.write(x)
io.write(y)

io.write()
io.write("=== nested destructuring ===")

a, (b, c) = (1, (2, 3))

io.write(a)
io.write(b)
io.write(c)

io.write()
io.write("=== final ===")

io.write("all tests passed")